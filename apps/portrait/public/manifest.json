{
  "id": "01a18fa7-97d6-7564-84c6-ad1e5386ec77",
  "name": "Portrait",
  "version": "0.2.0",
  "description": "Stand your Car Thing on its side: a vertical now-playing screen for whatever your desktop or phone is playing, with synced lyrics.",
  "icon": "icon.png",
  "settings": "settings.html",
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "rotation",
        "label": "Orientation",
        "description": "Which way the Car Thing is turned. Holding the back button on the device flips it too.",
        "choices": [
          "dial-top",
          "dial-bottom"
        ],
        "choiceLabels": {
          "dial-top": "Dial at the top",
          "dial-bottom": "Dial at the bottom"
        },
        "default": "dial-top"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "dial",
        "label": "Dial turns",
        "description": "What turning the dial does.",
        "choices": [
          "volume",
          "seek",
          "skip"
        ],
        "choiceLabels": {
          "volume": "Change volume",
          "seek": "Scrub through the track",
          "skip": "Skip tracks"
        },
        "default": "volume"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "invertDial",
        "label": "Reverse dial direction",
        "description": "Flip which way is up when turning the dial.",
        "default": false
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "sleepWhenPaused",
        "label": "Screen off when paused",
        "description": "Turn the screen off after the music has been paused this long. Touch, the dial or any button wakes it.",
        "choices": [
          "off",
          "2",
          "5",
          "15",
          "30"
        ],
        "choiceLabels": {
          "2": "After 2 minutes",
          "5": "After 5 minutes",
          "15": "After 15 minutes",
          "30": "After 30 minutes",
          "off": "Never"
        },
        "default": "5"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "followLaptop",
        "label": "Screen off with my laptop",
        "description": "Turn the screen off when your Mac's display sleeps (needs the Bridgething desktop app) or when your laptop and phone disconnect, and back on when they return.",
        "default": true
      }
    }
  ],
  "permissions": [],
  "overlays": {
    "volume": false
  },
  "art": {
    "heroPx": 416,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "run:/usr/bin/osascript"
    ],
    "api": 1
  }
}
